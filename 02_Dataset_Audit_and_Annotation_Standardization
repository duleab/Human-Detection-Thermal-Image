}\")\nPROJECT_ROOT = candidates[0]\nsys.path.insert(0, str(PROJECT_ROOT))\nfrom src.config import (\n    config_hash,\n    create_run_directory,\n    load_config,\n    resolve_paths,\n    save_json,\n    validate_config,\n)\nfrom src.reproducibility import dependency_readiness, inspect_environment, seed_everything\n\nCONFIG_PATH = Path(CONFIG_PATH_HINT).expanduser().resolve() if CONFIG_PATH_HINT else PROJECT_ROOT / \"configs/base.yaml\"\nprint(\"Project root:\", PROJECT_ROOT)\nprint(\"Configuration:\", CONFIG_PATH)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T02:28:06.976132Z","iopub.execute_input":"2026-11-20T02:28:06.97657Z","iopub.status.idle":"2026-11-20T02:28:08.107893Z","shell.execute_reply.started":"2026-11-20T02:28:06.976532Z","shell.execute_reply":"2026-11-20T02:28:08.10705Z"},"id":"ca3b7a09","outputId":"fea2271f-d82a-4290-f502-232485c3819d"},"outputs":[{"name":"stdout","text":"Project root: /kaggle/input/datasets/dule11/thermal-project-root\nConfiguration: /kaggle/input/datasets/dule11/thermal-project-root/configs/base.yaml\n","output_type":"stream"}],"execution_count":2},{"id":"6eb50cbc","cell_type":"code","source":"# Cell 7 — Inspect the current interpreter, binary compatibility, hardware, and baseline source.\nenvironment = inspect_environment()\nprint(json.dumps({key: environment[key] for key in\n                  (\"python\", \"platform\", \"cpu\", \"logical_cpu_count\", \"packages\", \"cuda\", \"errors\")}, indent=2))\nsource_record = environment[\"baseline_source\"]\nprint(\"FCOS source inspection:\", {key: value for key, value in source_record.items()\n                                 if key != \"factory_source\"})\nprint(\"CPU NMS check:\", environment[\"torchvision_nms_cpu\"])\nprint(\"No detector construction, weight loading, or GPU model test was performed.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T02:30:25.239011Z","iopub.execute_input":"2026-11-20T02:30:25.239482Z","iopub.status.id