ATH]\nnotebook_path = PROJECT_ROOT / \"notebooks/01_Research_Configuration_and_Environment.ipynb\"\nif notebook_path.is_file():\n    source_paths.append(notebook_path)\nsource_hashes = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in source_paths}\nartifact_payloads = {\n    \"config.json\": config,\n    \"environment.json\": environment,\n    \"reproducibility.json\": seed_report,\n    \"dependency_readiness.json\": readiness,\n    \"source_hashes.json\": source_hashes,\n    \"run.json\": run_metadata,\n}\ntargets = [run_dir / name for name in artifact_payloads] + [run_dir / \"packages.txt\"]\nif any(path.exists() for path in targets):\n    raise FileExistsError(\"Audit files already exist. Run all cells to create a fresh experiment directory.\")\nfor name, payload in artifact_payloads.items():\n    save_json(run_dir / name, payload)\nwith (run_dir / \"packages.txt\").open(\"x\", encoding=\"utf-8\") as handle:\n    handle.write(\"# Inspected project dependencies only; not a complete environment lockfile.\\n\")\n    for name, version in sorted(environment[\"packages\"].items()):\n        handle.write(f\"{name}=={version}\\n\" if version else f\"# {name}: not installed\\n\")\nsaved = json.loads((run_dir / \"config.json\").read_text(encoding=\"utf-8\"))\nassert config_hash(saved) == digest, \"Saved configuration hash differs\"\nprint(\"Saved and hash-verified:\", \", \".join(path.name for path in targets))\nprint(\"Environment smoke test finished; dataset/training readiness is recorded separately.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-20T02:30:37.187945Z","iopub.execute_input":"2026-11-20T02:30:37.188274Z","iopub.status.idle":"2026-11-20T02:30:37.287131Z","shell.execute_reply.started":"2026-11-20T02:30:37.18825Z","shell.execute_reply":"2026-11-20T02:30:37.286232Z"},"id":"c4768e5b","outputId":"57580538-824e-47d4-9d5e-378ce9c9d79c"},"outputs":[{"name":"stdout","text":"Saved and hash-verified: config.json, environment.json, reproducibility.json, dependency_readiness.json, source_hashes.json, run.json, packages.txt\nEnvironment smoke test finished; dataset/training readiness is recorded separately.\n","output_type":"stream"}],"execution_count":22},{"id":"0f11d4cc","cell_type":"markdown","source":"## Cell 15 — Reproducibility limitations\n\nSeeds and deterministic flags reduce variation; they do not guarantee bit-identical results\nacross PyTorch releases, CPU/GPU devices, kernels, or drivers. Strict deterministic algorithms\nmay reject unsupported operations later; investigate rather than silently disabling the setting.\n`PYTHONHASHSEED` takes effect at interpreter launch, so setting it inside a running notebook\ncannot reseed hash randomization. Set it before launching Jupyter when that control is required.\n`CUBLAS_WORKSPACE_CONFIG` is set before imports here, but an already initialized CUDA context\nin a reused kernel requires a kernel restart. Fresh NumPy `default_rng` objects need explicit\nseeds; a legacy NumPy seed does not seed independently constructed generators. Data-loader\nworker seeds, augmentation generators, and checkpoint RNG states belong to later notebooks.\n\nThe configuration SHA-256 covers effective configuration including resolved paths, not runtime\nIDs or timestamps. Relocating data changes that hash. Run IDs are intentionally unique.\nSource hashes and installed versions provide provenance; the small dependency inventory is\nnot a complete lockfile. Dataset version, grouping, split fingerprint, labels, and licenses\nremain unverified until the corresponding audits. Missing visibility/metadata/identities\nmust remain unavailable; downstream experiments stay disabled until their requirements hold.\n\nCPU NMS compatibility does not test a detector forward/backward pass, CUDA NMS, GPU training,\nor embedded deployment. This notebook performs no training, downloads, installs, annotation\nprocessing, threshold fitting, final-test evaluation, or model-performance measurement.","metadata":{"id":"0f11d4cc"}},{"id":"01772285","cell_type":"markdown","source":"## Cell 16 — Readiness checklist and running instructions\n\n- [ ] Run Cells 6–14 in order from a fresh kernel; inspect actual saved readiness/environment reports.\n- [ ] Confirm selected paths and that the unique run folder is writable and outside input data.\n- [ ] Confirm effective configuration hash, seed report, source record, and audit files exist.\n- [ ] Resolve any import/binary errors before the corresponding future experiments.\n- [ ] Before Notebook 02, attach the actual HIT-UAV copy and select its real root. Inspect version,\n      class mapping, annotation format, official splits, local license, and available metadata there.\n- [ ] Before training, complete manifest validators, leakage controls, frozen splits, loader/transform\n      tests, shape/finite-loss/gradient tests, and one-batch overfitting. None are implemented here.\n\n**Local:** open this notebook from the project root or `notebooks/` in Jupyter and select the\nintended Python environment. Run All. Run shared tests from the project root with\n`python -m unittest discover -s tests -v`.\n\n**Kaggle:** upload/attach the project containing `src/`, `configs/`, and `notebooks/` as a code\ndataset; import this notebook into a Python kernel. Cell 6 discovers actual code mounts under\n`/kaggle/input`; if needed set `PROJECT_ROOT_HINT` there to the directory containing `src/`\nand `configs/`. Attach HIT-UAV separately when available, and set `DATASET_ROOT_HINT` to its\nactual root. For configuration edits, copy `configs/base.yaml` to `/kaggle/working/base.yaml`,\nedit that copy, and set `CONFIG_PATH_HINT` in Cell 6. Do not modify `/kaggle/input`.\nInternet and GPU are unnecessary for Notebook 01. Run All; generated artifacts go to\n`/kaggle/working/artifacts/experiments/<unique-id>/`. Save/download that output after execution.\n\nRuntime category: **smoke test**, normally seconds to a few minutes depending on imports\nand storage. This is not a training-duration estimate. No installation commands execute.\n\nCompletion means this notebook's configuration/audit artifacts were written and verified,\nnot that the detector or data are ready for training. **Stop here.** Next is\n`02_Dataset_Audit_and_Annotation_Standardization.ipynb`, only after explicit approval.","metadata":{"id":"01772285"}}]}